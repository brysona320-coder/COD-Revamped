{
  "name": "echofront-visual-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "ArenaRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ArenaRoom"]}]
}
